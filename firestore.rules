rules_version = '2';

// Reference rules for this project's Firestore. Paste into
// Firebase Console -> Firestore Database -> Rules (or deploy via the
// Firebase CLI) — not applied automatically by this repo.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function roleOf() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasRole(role) {
      return signedIn() && roleOf() == role;
    }

    // DEMO-GRADE: a signed-in user may write their own profile, including the
    // role field, so the seed script can assign the four demo roles. Before any
    // real deployment, drop role writes here and assign roles from the console
    // or a trusted backend — otherwise a user can promote themselves.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // Public information: anyone can read without signing in.
    match /disasterAreas/{id} {
      allow read: if true;
      allow write: if hasRole('disaster_admin');
    }

    match /news/{id} {
      allow read: if true;
      allow write: if hasRole('news_manager');
    }

    match /weatherForecasts/{id} {
      allow read: if true;
      allow write: if hasRole('disaster_admin');
    }

    // A user creates and reads their own reports; the Disaster Admin reviews all.
    match /reports/{id} {
      allow create: if signedIn()
                    && request.resource.data.reportedBy == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read: if hasRole('disaster_admin')
                  || (signedIn() && resource.data.reportedBy == request.auth.uid);
      allow update: if hasRole('disaster_admin');
      allow delete: if false;
    }

    // A user creates and reads their own requests; the Relief Manager schedules all.
    match /reliefRequests/{id} {
      allow create: if signedIn()
                    && request.resource.data.requestedBy == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read: if hasRole('relief_manager')
                  || (signedIn() && resource.data.requestedBy == request.auth.uid);
      // The Relief Manager may change anything, including status and assignment.
      // The owner may correct their own request only while it is still pending,
      // and only the four descriptive fields — hasOnly() is what stops a user
      // from setting their own status to 'scheduled' or assigning themselves a team.
      allow update: if hasRole('relief_manager')
                    || (signedIn()
                        && resource.data.requestedBy == request.auth.uid
                        && resource.data.status == 'pending'
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['district', 'needType', 'peopleCount', 'description']));
      // The owner may withdraw a request, but only while it is still pending —
      // once a team and time are assigned the record belongs to the workflow.
      allow delete: if signedIn()
                    && resource.data.requestedBy == request.auth.uid
                    && resource.data.status == 'pending';
    }
  }
}
