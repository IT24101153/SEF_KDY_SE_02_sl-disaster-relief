rules_version = '2';

// Reference rules for this project's Firestore. Paste into
// Firebase Console → Firestore Database → Rules (or deploy via the
// Firebase CLI) — not applied automatically by this repo.
service cloud.firestore {
  match /databases/{database}/documents {
    // Public info: anyone can read, only signed-in admins can write.
    match /disasterAreas/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /weatherForecasts/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /news/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Reports: anyone can submit one, only signed-in admins can review/list.
    match /reports/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
